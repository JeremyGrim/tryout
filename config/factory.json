{
  "main_branch": "main",
  "remote": "origin",
  "work_dir": ".work",
  "slot": {
    "name": "push-slot",
    "log": null
  },
  "verify": {
    "rust": null,
    "npm_advisories": null,
    "steps": [
      {
        "title": "Tests Python",
        "when": [
          "^[^/]+\\.py$"
        ],
        "command": [
          "python",
          "-m",
          "unittest"
        ]
      },
      {
        "title": "Tests du backend",
        "when": [
          "^backend/"
        ],
        "command": [
          "cargo",
          "test",
          "--manifest-path",
          "backend/Cargo.toml"
        ]
      },
      {
        "title": "Build du frontend",
        "when": [
          "^frontend/"
        ],
        "command": [
          "npm",
          "--prefix",
          "frontend",
          "run",
          "build"
        ]
      }
    ],
    "all": []
  },
  "train": {
    "branch": "warden-train",
    "dock": "train-ready",
    "max_batch": 4,
    "install": null,
    "build": null,
    "min_free_memory_gib": 8,
    "memory_per_job_gib": 2
  },
  "version": {
    "line": "0.1",
    "files": [
      {
        "file": "config/version.json",
        "read": "json:version"
      },
      {
        "file": "backend/Cargo.toml",
        "read": "toml:package.version"
      },
      {
        "file": "frontend/package.json",
        "read": "json:version"
      }
    ]
  },
  "fixes": [
    "version",
    "lock",
    "generated"
  ]
}
